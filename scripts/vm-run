#!/usr/bin/env bash
# Unattended run on the VM: run one command, keep what it prints in data/<name>.log, copy the log
# and any listed result files to S3, then power the VM off so it stops billing.
#
#   tmux new -d -s <name> scripts/vm-run <name> [-t <s3 folder>] [-o <file>]... -- <command>...
#
#   -t  folder under s3://$WIKI_BUCKET/ to copy to    default: enwiki-20261101/text
#   -o  a result file or directory to copy as well; may be repeated, and may be a quoted pattern
#
# For example:
#   scripts/vm-run family_vectors -o 'data/enwiki_famil*.parquet' -- \
#     uv run python -m articular.experiments.family_vectors data/enwiki/*.bz2 --wiki enwiki --workers 8
# Several steps go in one command as: -- bash -c '<step>; <step>'
#
# The VM must define WIKI_BUCKET, the bucket to copy to, in /etc/profile.d/wiki.sh.
# Progress-bar lines are left out of the log. The VM powers off even if the command fails; the
# log's last line gives its exit status.
cd "$(dirname "$0")/.."
. /etc/profile.d/wiki.sh

name="${1:?usage: scripts/vm-run <name> [-t <s3 folder>] [-o <file>]... -- <command>...}"; shift
to="enwiki-20261101/text"
outputs=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  case "$1" in
    -t) to="$2"; shift 2 ;;
    -o) outputs+=("$2"); shift 2 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
shift
log="data/$name.log"

"$@" 2>&1 | tr '\r' '\n' | grep -v -e 'file/s\]$' -e 'it/s\]$' -e 's/it\]$' -e '/file\]$' > "$log"
echo "exit status ${PIPESTATUS[0]}" >> "$log"

for pattern in "${outputs[@]}"; do
  for f in $pattern; do
    if [ -d "$f" ]; then
      aws s3 sync --only-show-errors "$f" "s3://$WIKI_BUCKET/$to/$(basename "$f")/" >> "$log" 2>&1
    else
      aws s3 cp --only-show-errors "$f" "s3://$WIKI_BUCKET/$to/$(basename "$f")" >> "$log" 2>&1
    fi
  done
done
aws s3 cp --only-show-errors "$log" "s3://$WIKI_BUCKET/$to/$name.log"
sudo shutdown -h now
